# SkillBridge - Environment Configuration Example
# Duplicate this file to '.env' in the server directory and configure your credentials.

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge

# JWT Authentication Secret Key (Replace with a strong random secret)
JWT_SECRET=your_jwt_secret_key_here
